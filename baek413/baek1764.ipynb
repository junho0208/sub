   "source": [
    "n,m = map(int, input().split())\n",
    "nolisten = set()\n",
    "nosee = set()\n",
    "for i in range(n):\n",
    "    p = input()\n",
    "    nolisten.add(p)\n",
    "for i in range(m):\n",
    "    p = input()\n",
    "    nosee.add(p)\n",
    "weed = sorted(nolisten & nosee)\n",
    "print(len(weed))\n",
    "for i in weed:\n",
    "    print(i)"
   ]
  }
