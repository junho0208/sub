   "source": [
    "n = int(input())\n",
    "logs = {}\n",
    "\n",
    "for i in range(n):\n",
    "    p, l = map(str,input().split())\n",
    "    if l == \"enter\":\n",
    "        logs[p] = True\n",
    "    else:\n",
    "        if p in logs:\n",
    "            del logs[p]\n",
    "\n",
    "result = sorted(logs.keys(), reverse = True)\n",
    "\n",
    "for p in result:\n",
    "    print(p)"
   ]
  }
