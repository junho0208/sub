   "source": [
    "n = int(input())\n",
    "book = {}\n",
    "for i in range(n):\n",
    "    b = input()\n",
    "    if b in book:\n",
    "        book[b] += 1\n",
    "    else:\n",
    "        book[b] = 1\n",
    "max_sell = max(book.values())\n",
    "max_book = []\n",
    "for b, c in book.items():\n",
    "    if c == max_sell:\n",
    "        max_book.append(b)\n",
    "max_book.sort()\n",
    "print(max_book[0])"
   ]
  }
 ],
