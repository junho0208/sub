import os

def get_file_info(directory_path):

    file_info = {}
    
    with os.scandir(directory_path) as entries:
        for entry in entries:
            if entry.is_file():
                file_info[entry.name] = {
                    'size': entry.stat().st_size,
                    'path': entry.path
                }
    return file_info

def main():

    dir1_name = input("첫 번째 하위 디렉토리 이름을 입력하세요: ")
    dir2_name = input("두 번째 하위 디렉토리 이름을 입력하세요: ")


    if not os.path.isdir(dir1_name) or not os.path.isdir(dir2_name):
        print("오류: 입력한 디렉토리가 현재 위치에 존재하지 않습니다.")
        return

    
    dir1_files = get_file_info(dir1_name)
    dir2_files = get_file_info(dir2_name)

  
    if len(dir1_files) != len(dir2_files):
        print(f"결과: 두 디렉토리의 파일 개수가 다릅니다. "
              f"({dir1_name}: {len(dir1_files)}개, {dir2_name}: {len(dir2_files)}개)")
        return

    if set(dir1_files.keys()) != set(dir2_files.keys()):
        print("결과: 두 디렉토리의 파일 이름(구성)이 다릅니다.")
        return


    for name in dir1_files:
        file1 = dir1_files[name]
        file2 = dir2_files[name]


        if file1['size'] != file2['size']:
            print(f"결과: 파일 '{name}'의 크기가 다릅니다.")
            return


        with open(file1['path'], 'rb') as f1, open(file2['path'], 'rb') as f2:
            if f1.read() != f2.read():
                print(f"결과: 파일 '{name}'의 내용이 다릅니다.")
                return

    print("결과: 두 디렉토리는 완벽하게 동일합니다. (파일 개수, 이름, 크기, 내용 모두 일치)")

if __name__ == "__main__":
    main()
