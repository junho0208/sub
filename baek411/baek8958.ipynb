    "c = int(input())\n",
    "for i in range(c):\n",
    "    OX = input()\n",
    "    l = len(OX)\n",
    "    score = []\n",
    "    s = 0\n",
    "    for j in range(l):\n",
    "        if OX[j] == 'O':\n",
    "            s += 1\n",
    "            score.append(s)\n",
    "        else:\n",
    "            s = 0\n",
    "            score.append(s)\n",
    "    print(sum(score))"
   ]
